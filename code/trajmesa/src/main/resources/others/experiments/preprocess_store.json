{
  "inputConfig": {
    "@type": "hdfs",
    "master": "local[*]",
    "fsDefaultName": "hdfs://hostname/",
    "location": "hdfs://hostname/file/path",
    "fileMode": "multi_file",
    "partNum": 100
  },
  "dataConfig": {
    "@type": "trajectory",
    "attrIndexable": "true",
    "listIndex": "attr,xz2,xz3",
    "trajId": {
      "sourceName": "taxi_id",
      "dataType": "String",
      "index": 0
    },
    "objectId": {
      "sourceName": "taxi_id",
      "dataType": "String",
      "index": 0
    },
    "gpsPointConfig": {
      "@type": "gps_point",
      "pointId": {
        "sourceName": "taxi_id",
        "dataType": "String",
        "index": 0
      },
      "lat": {
        "sourceName": "lat",
        "dataType": "Double",
        "index": 3
      },
      "lng": {
        "sourceName": "lng",
        "dataType": "Double",
        "index": 2
      },
      "time": {
        "sourceName": "time",
        "dataType": "Date",
        "index": 1,
        "format": "yyyy-MM-dd HH:mm:ss"
      },
      "gpsPointMetas": []
    }
  },
  "preprocessConfig": {
    "filterParams": {
      "@type": "HEURISTIC_FILTER",
      "maxSpeedMeterPerSecond": 35.0,
      "minTrajLengthInKM": 1.0
    },
    "segmenterParams": {
      "maxTimeIntervalInMinute": 20,
      "maxStayDistInMeter": 50,
      "maxStayTimeInSecond": 300,
      "minTrajLengthInKM": 1,
      "segmenterType": "HYBRID_SEGEMENTER"
    }
  },
  "storeConfig": {
    "storePoint": false,
	"storeList": true,
    "outputConfig": {
      "@type": "geoMesa",
      "hbaseZookeepers": "host01:2181,host02:2181,host03:2181",
      "clientPort": 2181,
      "hbaseCatalog": "tdrive_catalog",
      "sftName": "tdrive",
      "mbrPrefix": "true",
      "precision": "16",
      "timePeriod": "month",
      "schemaType": "GPS_LIST_BASED_TRAJECTORY"
    }
  }
}